  m_Name: 
  m_EditorClassIdentifier: Protocolo404.Runtime::FluxoInicial
  painelIntroducao: {fileID: 1397209420}
  painelMenu: {fileID: 400572270}
  painelCircular: {fileID: 2117197845}
  painelGameplay: {fileID: 3075183}
  imagemIntroducao: {fileID: 354037564}
  textoIntroducao: {fileID: 1069207624}
  botaoContinuar: {fileID: 1348462307}
  audioDigitando: {fileID: 1071886080}
  audioClique: {fileID: 1835287728}
  somClique: {fileID: 8300000, guid: ecdf8a6491fc3dd439d0d38b0c19b4b5, type: 3}
  letrasPorSegundo: 35
  trechos:
  - imagem: {fileID: 0}
    texto: "O ano \xE9 2032."
  - imagem: {fileID: 0}
    texto: "A prefeitura mudou a forma de atender. Agora, quase tudo come\xE7a pelo
      portal. A promessa era resolver as coisas sem sair de casa."
  - imagem: {fileID: 0}
    texto: "Mas nem todo mundo tem internet, um celular compat\xEDvel ou facilidade
      para usar o sistema."
  - imagem: {fileID: 0}
    texto: "Ent\xE3o, eles se prepararam criando a Central do Cidad\xE3o: um posto
      p\xFAblico para orientar e ajudar quem precisa de atendimento presencial."
  - imagem: {fileID: 0}
    texto: E adivinha?
  - imagem: {fileID: 0}
    texto: "Hoje \xE9 meu primeiro dia trabalhando nela."
